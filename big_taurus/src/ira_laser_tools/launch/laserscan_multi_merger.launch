<!-- DESCRITPION -->

<launch>
	<node pkg="ira_laser_tools" name="laserscan_multi_merger" type="laserscan_multi_merger" output="screen">
	<param name="destination_frame" value="base_plate"/>
	<param name="cloud_destination_topic" value="/merged_cloud"/>
	<param name="scan_destination_topic" value="/scan_multi"/>
	<param name="laserscan_topics" value ="/scan /scan_2" /> <!-- LIST OF THE LASER SCAN TOPICS TO SUBSCRIBE -->
	<!-- <param name="angle_min" value="-2.8"/>
	<param name="angle_max" value="2.8"/> -->

	<param name="angle_min" value="-3.14159"/>   <!-- -180° -->
<param name="angle_max" value="3.14159"/>    <!-- +180° -->

	<param name="angle_increment" value="0.0058"/>
	<param name="scan_time" value="0.0333333"/>
	<param name="range_min" value="0.10"/>
	<param name="range_max" value="25"/>
	</node>
</launch>
